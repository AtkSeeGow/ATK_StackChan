# Copy to .env. The server reads it at startup. Restart after changes.
PORT=3000
# usb preserves the current working device; change to wifi after provisioning.
STACKCHAN_TRANSPORT=usb
STACKCHAN_SERIAL_PORT=COM4
# Optional Python path for USB mode; omit to use the existing bundled runtime.
# STACKCHAN_PYTHON=C:/path/to/python.exe
# Defaults for a fresh database; existing saved settings take precedence.
OLLAMA_URL=http://192.168.0.100:11434
OLLAMA_MODEL=qwen3.5:4b
# Localhost-only testing: leave public origin blank; device API is disabled
# until a 32+ character random device token is set.
STACKCHAN_PUBLIC_ORIGIN=
# Optional LAN HTTP device-only endpoint, e.g. http://192.168.0.199:3000
STACKCHAN_DEV_ORIGIN=
STACKCHAN_DEVICE_TOKEN=
# Required when public origin is enabled. Use different random credentials.
STACKCHAN_WEB_USER=
STACKCHAN_WEB_PASSWORD=
# Local speech recognition service on the GPU Server; distinct shared token.
STACKCHAN_STT_URL=http://192.168.0.100:8001
STACKCHAN_STT_TOKEN=
